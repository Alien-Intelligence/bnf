# BnF broker — copy to .env and fill the real credentials. NEVER commit .env.
# The BnF KEY/SECRET live ONLY here; the app and worker hold no BnF credentials.

# OAuth2 client_credentials — the INGESTION subscription. REQUIRED — no default.
BNF_CLIENT_KEY=<obtenir auprès de la BnF — NE PAS COMMITTER>
BNF_CLIENT_SECRET=<obtenir auprès de la BnF — NE PAS COMMITTER>
BNF_OAUTH_TOKEN_URL=https://apimauthproext.bnf.fr/oauth2/token

# Upstream partner API host (authenticated). MUST be openapiproext.bnf.fr (the
# token'd host) — NOT openapi.bnf.fr, which is the public, no-token,
# anonymous-per-IP IIIF mirror (no quota attribution).
BNF_API_BASE_URL=https://openapiproext.bnf.fr

# Rates (requests/min + burst) — ALL REQUIRED, no defaults: the broker refuses to
# boot without any one of them. Same values as helm broker.config.rates (the
# ingestion subscription's quotas; rpm = floor(0.95 q), burst = max(1, floor(0.02 q)),
# rpm + burst <= quota). See README.md "Configuration".
BNF_GLOBAL_RPM=950
BNF_GLOBAL_BURST=20
BNF_PRESENTATION_RPM=1425
BNF_PRESENTATION_BURST=30
BNF_IMAGE_RPM=285
BNF_IMAGE_BURST=6
BNF_IIIF_LEGACY_RPM=950
BNF_IIIF_LEGACY_BURST=20
BNF_CATALOGUE_RPM=95
BNF_CATALOGUE_BURST=2
BNF_GALLICA_SRU_RPM=95
BNF_GALLICA_SRU_BURST=2
BNF_GRAPHE_DATA_RPM=47
BNF_GRAPHE_DATA_BURST=1
BNF_DATE_PERIODIQUE_RPM=95
BNF_DATE_PERIODIQUE_BURST=2
BNF_DOCUMENT_TDM_RPM=95
BNF_DOCUMENT_TDM_BURST=2
# Per-IP manifest sub-limit (on top of presentation/iiifLegacy + global).
BNF_MANIFEST_RPM=38
BNF_MANIFEST_BURST=2
# Ungated hosts (oai/catalogue/data.bnf.fr) — politeness only, not a BnF quota.
BNF_EXTERNAL_RPM=120
BNF_EXTERNAL_BURST=20

# Server
PORT=8792

# Rows kept in the in-memory call log exported at GET /calls.csv (every /fetch
# outcome — for rate-limit analysis). 0 disables. Default 200000.
# BNF_CALLS_LOG_SIZE=200000

# Tuning (optional, documented defaults)
# BNF_ACQUIRE_MAX_WAIT_MS=10000  BNF_TOKEN_SKEW_SEC=60  BNF_UPSTREAM_TIMEOUT_MS=120000  BNF_TOKEN_TIMEOUT_MS=10000
